class Solution:
    def closedIsland(self, grid):
        
        n = len(grid)
        m = len(grid[0])
        
        def dfs(r, c):
            if r < 0 or c < 0 or r >= n or c >= m:
                return
            if grid[r][c] == 1:
                return
            
            grid[r][c] = 1  
            
            dfs(r+1, c)
            dfs(r-1, c)
            dfs(r, c+1)
            dfs(r, c-1)
        
        for i in range(n):
            dfs(i, 0)
            dfs(i, m-1)
        
        for j in range(m):
            dfs(0, j)
            dfs(n-1, j)
        
        count = 0
        for i in range(n):
            for j in range(m):
                if grid[i][j] == 0:
                    dfs(i, j)
                    count += 1
        return count

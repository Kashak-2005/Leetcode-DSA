class Solution:
    def findTheDistanceValue(self, arr1: list[int], arr2: list[int], d: int) -> int:
        arr2.sort()
        count = 0
        for num in arr1:
            index = bisect_left(arr2, num - d)
            is_valid = (index == len(arr2) or arr2[index] > num + d)
            count += is_valid
        return count

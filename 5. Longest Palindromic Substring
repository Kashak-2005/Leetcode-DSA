class Solution:
    def longestPalindrome(self, s: str) -> str:
        n = len(s)
        dp = [[-1] * n for _ in range(n)]
        def fxn(l, r):
            if l >= r:
                return True
            if dp[l][r] != -1:
                return dp[l][r]
            if s[l] == s[r]:
                dp[l][r] = fxn(l+1, r-1)
            else:
                dp[l][r] = False
            return dp[l][r]
        m = 0
        for i in range(n):
            for j in range(i, n):
                if fxn(i, j):
        return m


        
        
        
